rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function validText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['bio', 'phone', 'location', 'website', 'photoUrl', 'avatar'])
        && request.resource.data.keys().hasOnly(['bio', 'phone', 'location', 'website', 'photoUrl', 'avatar'])
        && validText(request.resource.data.bio, 0, 300)
        && validText(request.resource.data.phone, 0, 30)
        && validText(request.resource.data.location, 0, 100)
        && validText(request.resource.data.website, 0, 250)
        && validText(request.resource.data.photoUrl, 0, 500)
        && (request.resource.data.website == '' || request.resource.data.website.matches('https://[^/]+.*'))
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('https://[^/]+.*'))
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0 && request.resource.data.avatar <= 4;
      allow delete: if false;
    }
    match /feedback/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId', 'author', 'category', 'subject', 'message', 'suggestion', 'rating', 'createdAt', 'status', 'reply'])
        && request.resource.data.keys().hasOnly(['userId', 'author', 'category', 'subject', 'message', 'suggestion', 'rating', 'createdAt', 'status', 'reply'])
        && request.resource.data.userId == request.auth.uid
        && validText(request.resource.data.author, 1, 80)
        && request.resource.data.category in ['Task', 'Course', 'Service']
        && validText(request.resource.data.subject, 3, 120)
        && validText(request.resource.data.message, 10, 2000)
        && validText(request.resource.data.suggestion, 0, 1000)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'New'
        && request.resource.data.reply == '';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply'])
        && request.resource.data.status in ['New', 'In progress', 'Resolved']
        && validText(request.resource.data.reply, 0, 2000);
      allow delete: if false;
    }
  }
}
